+.tutorial-card-face:nth-child(2) { left: 72px; top: 17px; transform: rotate(-4deg); }
+.tutorial-card-face:nth-child(3) { left: 126px; top: 18px; transform: rotate(5deg); }
+.tutorial-card-face:nth-child(4) { left: 170px; top: 47px; transform: rotate(13deg); }
+
+.rank-ladder {
+    display: flex;
+    align-items: flex-end;
+    gap: 7px;
+}
+
+.rank-tile {
+    width: 40px;
+    height: 58px;
+    display: grid;
+    place-items: center;
