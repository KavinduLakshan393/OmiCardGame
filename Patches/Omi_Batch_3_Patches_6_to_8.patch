+
+.suit-options {
+    display: flex;
+    gap: 10px;
+}
+
+.suit-option {
+    width: 45px;
+    height: 45px;
+    display: grid;
+    place-items: center;
+    border: 1px solid var(--menu-line);
+    border-radius: 50%;
+    font-family: var(--font-card);
+    font-size: 1.45rem;
+}
+
+.suit-option.selected {
+    border-color: var(--menu-text);
+    box-shadow: 0 0 0 4px rgba(255,255,255,.06);
+}
+
+.lead-demo,
+.follow-demo,
+.target-demo,
+.ready-demo {
+    display: grid;
+    place-items: center;
+    gap: 24px;
+}
+
+.lead-caption {
+    color: var(--menu-text-muted);
+    font-size: .62rem;
+    letter-spacing: .13em;
+    text-transform: uppercase;
+}
+
+.trick-card-ui {
+    position: absolute;
+    width: 68px;
+    height: 98px;
+    display: grid;
+    place-items: center;
+    border-radius: 5px;
+    background: var(--card-white);
+    color: var(--suit-black);
+    font-family: var(--font-card);
+    font-size: 1.42rem;
+}
+
+.trick-card-ui.red { color: #b62835; }
+.trick-card-ui.n { top: 28px; left: 108px; }
+.trick-card-ui.s { bottom: 28px; left: 108px; }
+.trick-card-ui.w { left: 31px; top: 94px; }
+.trick-card-ui.e { right: 31px; top: 94px; }
+.trick-card-ui.winner { box-shadow: 0 0 0 3px rgba(255,255,255,.88), 0 0 28px rgba(255,255,255,.16); }
+
+.scoring-board {
+    width: min(100%, 320px);
+    border: 1px solid rgba(255,255,255,.11);
+}
+
+.scoring-row {
+    display: grid;
+    grid-template-columns: 1fr 66px;
+    gap: 14px;
+    align-items: center;
+    padding: 15px 17px;
+    border-bottom: 1px solid rgba(255,255,255,.08);
+}
+
+.scoring-row:last-child { border-bottom: 0; }
+.scoring-name { font-family: var(--font-menu); font-size: 1.16rem; }
+.scoring-sub { display: block; margin-top: 2px; font-family: var(--font-ui); font-size: .52rem; letter-spacing: .08em; text-transform: uppercase; color: var(--menu-text-muted); }
+.scoring-value { text-align: right; font-family: var(--font-display); font-size: 1.9rem; }
+
+.target-number {
+    font-family: var(--font-display);
+    font-size: 6.3rem;
+    line-height: .8;
+}
+
+.target-label {
+    font-size: .62rem;
+    letter-spacing: .18em;
+    text-transform: uppercase;
+    color: var(--menu-text-muted);
+}
+
+.ready-ring {
+    width: 175px;
+    height: 175px;
+    display: grid;
+    place-items: center;
+    border: 1px solid var(--menu-line);
+    border-radius: 50%;
+    font-family: var(--font-menu);
+    font-size: 4.5rem;
+}
+
+@keyframes tutorial-enter {
+    from { opacity: 0; transform: translateY(10px); filter: blur(5px); }
+    to { opacity: 1; transform: translateY(0); filter: blur(0); }
+}
+
+@media (max-width: 860px) {
+    body.tutorial-page { overflow: auto; }
+    .tutorial-shell { min-height: 100svh; }
+    .tutorial-main { overflow: visible; }
+    .tutorial-layout { grid-template-columns: 1fr; max-width: 650px; }
+    .tutorial-copy { max-width: none; }
+    .tutorial-visual { min-height: 350px; }
+}
+
+@media (max-width: 600px) {
+    .tutorial-header {
+        min-height: 66px;
+        grid-template-columns: 1fr auto;
+        padding: 12px 16px;
+    }
+
+    .tutorial-brand { display: none; }
+    .tutorial-progress-text { justify-self: start; }
+    .tutorial-main { padding: 25px 16px; }
+    .tutorial-step-title { font-size: clamp(2.9rem, 15vw, 4.25rem); }
+    .tutorial-visual { min-height: 330px; }
+    .tutorial-footer {
+        min-height: 108px;
+        grid-template-columns: 1fr;
+        gap: 11px;
+        padding: 13px 16px;
+    }
+    .tutorial-shortcut { display: none; }
+    .tutorial-dots { grid-row: 1; }
+    .tutorial-nav { justify-self: stretch; display: grid; grid-template-columns: 1fr 1fr; }
+    .tutorial-button { width: 100%; }
+    .seat-map, .trick-map { transform: scale(.86); }
+    .rank-ladder { gap: 4px; transform: scale(.9); }
+}
