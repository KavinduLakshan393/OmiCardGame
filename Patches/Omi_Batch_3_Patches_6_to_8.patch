+                <article class="tutorial-copy" id="tutorial-copy">
+                    <div class="tutorial-kicker" id="tutorial-kicker"></div>
+                    <h1 class="tutorial-step-title" id="tutorial-title"></h1>
+                    <p class="tutorial-body-copy" id="tutorial-body"></p>
+                    <ul class="tutorial-rules" id="tutorial-rules"></ul>
+                </article>
+
+                <div class="tutorial-visual" id="tutorial-visual" aria-live="polite">
+                    <div class="visual-stage" id="visual-stage"></div>
+                    <div class="visual-caption" id="visual-caption"></div>
+                </div>
+            </div>
+        </section>
+
+        <footer class="tutorial-footer">
+            <div class="tutorial-shortcut">← / → Navigate · Esc Exit</div>
+            <div class="tutorial-dots" id="tutorial-dots" aria-hidden="true"></div>
+            <div class="tutorial-nav">
