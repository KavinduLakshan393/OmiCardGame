+.seat.n { top: 15px; left: 50%; transform: translateX(-50%); }
+.seat.s { bottom: 15px; left: 50%; transform: translateX(-50%); color: var(--menu-text); }
+.seat.w { left: -8px; top: 50%; transform: translateY(-50%); }
+.seat.e { right: -8px; top: 50%; transform: translateY(-50%); }
+
+.team-axis {
+    position: absolute;
+    background: rgba(255,255,255,.10);
+}
+
+.team-axis.vertical { width: 1px; height: 145px; left: 50%; top: 70px; }
+.team-axis.horizontal { height: 1px; width: 145px; left: 70px; top: 50%; }
+
+.tutorial-card-fan {
+    position: relative;
+    width: 250px;
+    height: 210px;
+}
+
+.tutorial-card-face {
+    position: absolute;
+    width: 92px;
+    height: 132px;
+    display: grid;
+    place-items: center;
+    border-radius: 7px;
