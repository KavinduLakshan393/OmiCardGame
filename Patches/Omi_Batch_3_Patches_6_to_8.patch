diff --git a/styles/base.css b/styles/base.css
new file mode 100644
index 0000000..d9d30d3
--- /dev/null
+++ b/styles/base.css
@@ -0,0 +1,67 @@
+*, *::before, *::after {
+    box-sizing: border-box;
+}
+
+html {
+    color-scheme: dark;
+    -webkit-text-size-adjust: 100%;
+}
+
+body {
+    margin: 0;
+    min-width: 320px;
+    font-family: var(--font-ui);
+    background: var(--menu-bg);
+    color: var(--menu-text);
+    -webkit-font-smoothing: antialiased;
+    text-rendering: optimizeLegibility;
+}
+
+button,
+select,
+input,
+textarea {
+    font: inherit;
+}
+
+button,
+a {
+    -webkit-tap-highlight-color: transparent;
+}
+
+a {
+    color: inherit;
+}
+
+button:focus-visible,
+a:focus-visible,
+select:focus-visible,
+[tabindex]:focus-visible {
+    outline: 2px solid var(--accent-gold);
+    outline-offset: 3px;
+}
+
+.visually-hidden {
+    position: absolute !important;
+    width: 1px !important;
+    height: 1px !important;
+    padding: 0 !important;
+    margin: -1px !important;
+    overflow: hidden !important;
+    clip: rect(0, 0, 0, 0) !important;
+    white-space: nowrap !important;
+    border: 0 !important;
+}
+
+@media (prefers-reduced-motion: reduce) {
+    html:focus-within {
+        scroll-behavior: auto;
+    }
+
+    *, *::before, *::after {
+        animation-duration: 0.01ms !important;
+        animation-iteration-count: 1 !important;
+        transition-duration: 0.01ms !important;
+        scroll-behavior: auto !important;
+    }
+}
diff --git a/styles/game-legacy.css b/styles/game-legacy.css
new file mode 100644
index 0000000..3e1b7d7
--- /dev/null
+++ b/styles/game-legacy.css
@@ -0,0 +1,580 @@
+/* ===== RESET ===== */
+*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
+html, body {
+    width: 100%; height: 100%;
+    overflow: hidden;
+    font-family: var(--font-ui);
+    background: #0a1a0f;
+    color: #fff;
+}
+
+/* ===== GAME BOARD — CSS Grid ===== */
+#game-board {
+    width: 100vw;
+    height: 100vh;
+    display: grid;
+    grid-template-rows: auto 1fr auto;
+    grid-template-columns: 148px 1fr 148px;
+    grid-template-areas:
+        "header  header  header"
+        "west    center  east"
+        "footer  footer  footer";
+    background: radial-gradient(ellipse at center, #1e5e3a 0%, #0d2918 100%);
+}
+
+/* ===== HEADER ===== */
+#header-area {
+    grid-area: header;
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    padding: 7px 16px;
+    gap: 8px;
+    background: rgba(0,0,0,0.5);
+    border-bottom: 1px solid rgba(255,255,255,0.1);
+    z-index: 10;
+}
+.score-box { text-align: center; min-width: 130px; }
+.score-label { font-size: 0.7rem; font-weight: 700; color: #aaa; text-transform: uppercase; letter-spacing: 0.6px; display: block; }
+.score-value { font-size: 1rem; font-weight: 800; color: #4cd137; }
+#status-banner {
+    flex: 1;
+    background: rgba(255,255,255,0.1);
+    border: 1px solid rgba(255,255,255,0.18);
+    border-radius: 20px;
+    padding: 5px 18px;
+    font-size: 0.95rem;
+    font-weight: 800;
+    color: #fbc531;
+    text-align: center;
+    white-space: nowrap;
+    overflow: hidden;
+    text-overflow: ellipsis;
+}
+.header-controls {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+}
+.icon-btn {
+    background: rgba(255,255,255,0.12);
+    border: 1px solid rgba(255,255,255,0.2);
+    color: #fff;
+    border-radius: 10px;
+    width: 34px; height: 34px;
+    font-size: 1.1rem;
+    cursor: pointer;
+    display: flex; align-items: center; justify-content: center;
+    transition: background .2s, transform .15s;
+}
+.icon-btn:hover { background: rgba(255,255,255,0.22); transform: scale(1.08); }
+
+/* ===== WEST / EAST SIDE COLUMNS ===== */
+#west-area {
+    grid-area: west;
+    display: flex; flex-direction: column;
+    align-items: center; justify-content: center;
+    padding: 8px 4px; overflow: hidden;
+}
+#east-area {
+    grid-area: east;
+    display: flex; flex-direction: column;
+    align-items: center; justify-content: center;
+    padding: 8px 4px; overflow: hidden;
+}
+
+/* ===== CENTER COLUMN ===== */
+#center-area {
+    grid-area: center;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: space-between;
+    padding: 8px 0 6px;
+    overflow: hidden;
+    gap: 4px;
+}
+
+/* ===== PLAYER NORTH / SOUTH WRAPPERS ===== */
+#player-north, #player-south {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 4px;
+}
+
+/* ===== CENTER MIDDLE: TRICK TABLE + HISTORY ===== */
+#center-middle {
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    gap: 6px;
+    flex-shrink: 0;
+}
+
+/* ===== TRICK TABLE ===== */
+#trick-table {
+    position: relative;
+    width: 260px;
+    height: 240px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    flex-shrink: 0;
+}
+.trick-table-bg {
+    position: absolute;
+    inset: 0;
+    border-radius: 50%;
+    background: rgba(0,0,0,0.28);
+    border: 2px dashed rgba(255,255,255,0.13);
+}
+.trick-slot {
+    position: absolute;
+    width: 72px; height: 108px;
+    display: flex; align-items: center; justify-content: center;
+}
+#trick-north { top: 8px; left: 50%; transform: translateX(-50%); }
+#trick-south { bottom: 8px; left: 50%; transform: translateX(-50%); }
+#trick-west  { left: 8px; top: 50%; transform: translateY(-50%); }
+#trick-east  { right: 8px; top: 50%; transform: translateY(-50%); }
+
+.winner-flash {
+    animation: winFlash 0.6s ease-out;
+}
+@keyframes winFlash {
+    0%   { filter: drop-shadow(0 0 0px #fbc531); }
+    40%  { filter: drop-shadow(0 0 18px #fbc531); }
+    100% { filter: drop-shadow(0 0 0px #fbc531); }
+}
+
+/* ===== DECK PILE ===== */
+#deck-pile {
+    position: absolute;
+    width: 72px; height: 108px;
+    top: 50%; left: 50%;
+    transform: translate(-50%, -50%);
+    z-index: 6;
+    display: none;
+    align-items: center; justify-content: center;
+}
+.deck-card {
+    position: absolute;
+    width: 72px; height: 108px;
+    background: linear-gradient(135deg, #1a2e82, #0b1a4f);
+    border: 2px solid #f0c040;
+    border-radius: 8px;
+    box-shadow: 2px 4px 10px rgba(0,0,0,0.5);
+}
+
+/* ===== TRUMP BADGE ===== */
+#trump-badge {
+    position: absolute;
+    display: flex; flex-direction: column; align-items: center;
+    background: rgba(0,0,0,0.8);
+    border: 1px solid rgba(255,255,255,0.2);
+    border-radius: 12px;
+    padding: 3px 10px;
+    z-index: 5;
+}
+#trump-badge .t-label { font-size: 0.58rem; font-weight: 800; letter-spacing: 1px; color: #fbc531; }
+#trump-badge .t-suit  { font-size: 1.4rem; line-height: 1.1; }
+#trump-badge .t-caller { font-size: 0.62rem; color: #bbb; }
+
+/* ===== TRICK HISTORY STRIP ===== */
+#trick-history-panel {
+    display: flex;
+    flex-direction: row;
+    gap: 8px;
+    align-items: flex-start;
+    min-height: 52px;
+    padding: 4px 6px;
+    background: rgba(0,0,0,0.25);
+    border-radius: 10px;
+    max-width: 260px;
+    overflow-x: auto;
+}
+.history-item { display: flex; flex-direction: column; gap: 2px; align-items: flex-start; }
+.history-label { font-size: 0.58rem; color: #aaa; white-space: nowrap; }
+.history-cards { display: flex; flex-direction: row; gap: 2px; }
+.mini-card {
+    font-size: 0.65rem; font-weight: 800;
+    background: #fff; color: #111;
+    padding: 1px 3px;
+    border-radius: 4px;
+    border: 1px solid #ccc;
+    white-space: nowrap;
+}
+.mini-card.red { color: #d00; }
+.history-empty { font-size: 0.7rem; color: #666; align-self: center; }
+
+/* ===== PLAYER LABEL ===== */
+.player-area { display: flex; flex-direction: column; align-items: center; gap: 3px; }
+.player-label {
+    display: flex; align-items: center; gap: 6px;
+    background: rgba(0,0,0,0.5);
+    border: 1.5px solid transparent;
+    border-radius: 10px;
+    padding: 3px 10px;
+    font-size: 0.8rem; font-weight: 700;
+    transition: border-color .3s, box-shadow .3s;
+}
+.turn-badge {
+    background: #fbc531; color: #000;
+    font-size: 0.68rem; font-weight: 800;
+    padding: 1px 7px; border-radius: 8px;
+    animation: pulseBadge 0.9s ease-in-out infinite alternate;
+}
+.turn-badge.hidden { display: none; }
+@keyframes pulseBadge {
+    from { opacity: 0.8; transform: scale(0.97); }
+    to   { opacity: 1;   transform: scale(1.06); }
+}
+.player-area.active-turn .player-label {
+    border-color: #fbc531;
+    box-shadow: 0 0 14px #fbc531aa;
+}
+
+/* ===== HANDS ===== */
+.hand-h {
+    display: flex; flex-direction: row;
+    align-items: flex-end; justify-content: center;
+    padding: 0 8px;
+}
+.hand-v {
+    display: flex; flex-direction: column;
+    align-items: center; justify-content: center;
+}
+
+/* ===== CARD WRAPPER ===== */
+.card-wrapper {
+    position: relative;
+    display: inline-block;
+    cursor: pointer;
+    transition: none;
+}
+
+/* ===== CARD ===== */
+.card {
+    width: 72px; height: 108px;
+    background: #fff;
+    border-radius: 8px;
+    border: 1.5px solid #ccc;
+    box-shadow: 2px 4px 12px rgba(0,0,0,0.38);
+    display: flex; flex-direction: column;
+    justify-content: space-between;
+    padding: 5px 5px;
+    position: relative;
+    user-select: none;
+    transition: box-shadow .2s, border-color .2s;
+}
+.card.red  { color: #d00; }
+.card.black { color: #111; }
+
+/* Valid / Invalid card highlighting */
+.card.card-valid {
+    border-color: #4cd137;
+    box-shadow: 0 0 14px 3px rgba(76,209,55,0.6), 2px 4px 12px rgba(0,0,0,0.38);
+}
+.card.card-invalid {
+    opacity: 0.38;
+    filter: grayscale(55%);
+    cursor: not-allowed;
+}
+
+/* Shake animation for invalid plays */
+.card.shake {
+    animation: shakeCard 0.35s ease;
+}
+@keyframes shakeCard {
+    0%,100%{ transform: translateX(0); }
+    25%    { transform: translateX(-7px); }
+    75%    { transform: translateX(7px); }
+}
+
+/* Card corners */
+.card-tl { display: flex; flex-direction: column; align-items: flex-start; line-height: 1; }
+.card-br { display: flex; flex-direction: column; align-items: flex-end; line-height: 1; transform: rotate(180deg); }
+.card-tl .cr, .card-br .cr { font-size: 0.95rem; font-weight: 900; }
+.card-tl .cs, .card-br .cs { font-size: 0.8rem; font-weight: 700; margin-top: 1px; }
+
+/* Card center */
+.card-center {
+    position: absolute;
+    top: 50%; left: 50%;
+    transform: translate(-50%, -50%);
+    pointer-events: none;
+}
+.card-center.ace-big { font-size: 2rem; }
+.card-center.pip-center { font-size: 1.5rem; }
+.card-center.court {
+    display: flex; flex-direction: column; align-items: center;
+}
+.court-icon { font-size: 1.5rem; line-height: 1; }
+.court-sub  { font-size: 0.8rem; margin-top: 1px; }
+
+/* Face-down card */
+.card.face-down {
+    background: linear-gradient(135deg, #1a2e82 0%, #0b1a4f 100%);
+    border: 2px solid #f0c040;
+    cursor: default;
+}
+.card.face-down::after {
+    content: '';
+    position: absolute; inset: 5px;
+    border: 1px solid rgba(240,192,64,0.35);
+    border-radius: 4px;
+    background: repeating-linear-gradient(
+        45deg,
+        transparent, transparent 6px,
+        rgba(255,255,255,0.04) 6px, rgba(255,255,255,0.04) 7px
+    );
+}
+
+/* Trick slot played card */
+.trick-slot .card {
+    width: 72px; height: 108px;
+    animation: cardPop 0.22s cubic-bezier(.175,.885,.32,1.275);
+    cursor: default;
+}
+@keyframes cardPop {
+    from { opacity: 0; transform: scale(0.5) rotate(-5deg); }
+    to   { opacity: 1; transform: scale(1) rotate(0deg); }
+}
+
+/* ===== FOOTER ===== */
+#footer-area {
+    grid-area: footer;
+    display: flex;
+    justify-content: center;
+    align-items: center;
+    gap: 10px;
+    padding: 6px 16px;
+    background: rgba(0,0,0,0.35);
+}
+.btn {
+    font-family: var(--font-ui);
+    font-weight: 800; font-size: 0.9rem;
+    padding: 8px 20px;
+    border-radius: 20px; border: none;
+    cursor: pointer;
+    transition: transform .15s, box-shadow .15s, opacity .2s;
+}
+.btn:disabled { opacity: 0.4; cursor: not-allowed; }
+.btn-primary {
+    background: linear-gradient(135deg, #f9ca24 0%, #44bd32 100%);
+    color: #000;
+    box-shadow: 0 4px 14px rgba(68,189,50,0.4);
+}
+.btn-primary:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(68,189,50,0.5); }
+.btn-secondary {
+    background: rgba(255,255,255,0.12);
+    color: #fff;
+    border: 1px solid rgba(255,255,255,0.2);
+}
+.btn-secondary:hover:not(:disabled) { background: rgba(255,255,255,0.2); transform: translateY(-1px); }
+
+/* ===== TRICK WIN OVERLAY (floating banner) ===== */
+#trick-win-overlay {
+    position: fixed;
+    top: 50%; left: 50%;
+    transform: translate(-50%, -50%) scale(0.8);
+    background: rgba(0,0,0,0.85);
+    border: 2px solid #fbc531;
+    border-radius: 16px;
+    padding: 12px 28px;
+    font-size: 1.2rem; font-weight: 800; color: #fbc531;
+    z-index: 600;
+    pointer-events: none;
+    opacity: 0;
+    transition: opacity 0.3s, transform 0.3s;
+    white-space: nowrap;
+}
+#trick-win-overlay.show {
+    opacity: 1;
+    transform: translate(-50%, -50%) scale(1);
+}
+#trick-win-overlay.hidden { display: none; }
+
+/* ===== ROUND OVERLAY ===== */
+#round-overlay {
+    position: fixed; inset: 0;
+    background: rgba(0,0,0,0.6);
+    backdrop-filter: blur(4px);
+    display: flex; align-items: center; justify-content: center;
+    z-index: 550;
+    animation: fadeIn 0.3s ease;
+}
+#round-overlay.hidden { display: none; }
+#round-overlay-box {
+    background: #1a252f;
+    border: 1px solid rgba(255,255,255,0.15);
+    border-radius: 20px;
+    padding: 28px 36px;
+    text-align: center;
+    animation: slideUp 0.3s ease;
+}
+#round-overlay-msg {
+    font-size: 1.3rem; font-weight: 800; color: #fbc531;
+}
+@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
+@keyframes slideUp {
+    from { opacity: 0; transform: translateY(20px); }
+    to   { opacity: 1; transform: translateY(0); }
+}
+
+/* ===== MATCH WIN OVERLAY ===== */
+#match-win-overlay {
+    position: fixed; inset: 0;
+    background: rgba(0,0,0,0.8);
+    backdrop-filter: blur(8px);
+    display: flex; flex-direction: column;
+    align-items: center; justify-content: center;
+    z-index: 700;
+    gap: 16px;
+}
+#match-win-overlay.hidden { display: none; }
+#match-win-box {
+    background: linear-gradient(135deg, #1a252f, #0d2918);
+    border: 2px solid #fbc531;
+    border-radius: 24px;
+    padding: 36px 48px;
+    text-align: center;
+    animation: slideUp 0.4s ease;
+}
+#match-winner-text { font-size: 1.8rem; font-weight: 800; color: #fbc531; margin-bottom: 8px; }
+#match-stats-text  { font-size: 1rem; color: #bbb; margin-bottom: 20px; }
+.match-win-actions { display: flex; gap: 12px; justify-content: center; }
+
+/* ===== LOG SIDEBAR ===== */
+#log-sidebar {
+    position: fixed;
+    right: 0; top: 0; bottom: 0;
+    width: 210px;
+    background: rgba(0,0,0,0.75);
+    backdrop-filter: blur(8px);
+    border-left: 1px solid rgba(255,255,255,0.12);
+    display: flex; flex-direction: column;
+    z-index: 200;
+    transition: transform 0.3s ease;
+}
+#log-sidebar.collapsed { transform: translateX(100%); }
+#log-sidebar-header {
+    display: flex; align-items: center; justify-content: space-between;
+    padding: 8px 10px;
+    background: rgba(255,255,255,0.05);
+    border-bottom: 1px solid rgba(255,255,255,0.1);
+    font-size: 0.75rem; font-weight: 800; color: #fbc531;
+    letter-spacing: 0.5px;
+}
+#log-close-btn {
+    background: none; border: none; color: #aaa;
+    cursor: pointer; font-size: 1rem; line-height: 1;
+}
+#log-close-btn:hover { color: #fff; }
+#game-log-list {
+    flex: 1; overflow-y: auto;
+    list-style: none;
+    padding: 6px;
+    display: flex; flex-direction: column; gap: 3px;
+    scrollbar-width: thin;
+    scrollbar-color: rgba(255,255,255,0.2) transparent;
+}
+.log-entry {
+    font-size: 0.7rem; padding: 3px 6px;
+    border-radius: 5px;
+    border-left: 2px solid transparent;
+    line-height: 1.4;
+}
+.log-time { color: #666; margin-right: 4px; }
+.log-play  { border-left-color: #4cd137; background: rgba(76,209,55,0.06); }
+.log-trick { border-left-color: #fbc531; background: rgba(251,197,49,0.06); color: #fbc531; }
+.log-trump { border-left-color: #9b59b6; background: rgba(155,89,182,0.08); color: #d7bff5; }
+.log-result { border-left-color: #e84118; background: rgba(232,65,24,0.08); color: #ff9980; font-weight: 700; }
+.log-round  { border-left-color: #00a8ff; background: rgba(0,168,255,0.08); color: #7fcfff; font-weight: 700; }
+.log-match  { border-left-color: #fbc531; background: rgba(251,197,49,0.15); color: #fbc531; font-weight: 800; }
+.log-info   { color: #888; }
+.log-pass   { color: #aaa; border-left-color: #666; }
+
+/* ===== TRUMP MODAL ===== */
+#modal-overlay {
+    position: fixed; inset: 0;
+    background: rgba(0,0,0,0.75);
+    backdrop-filter: blur(6px);
+    display: flex; align-items: center; justify-content: center;
+    z-index: 500;
+}
+#modal-overlay.hidden { display: none; }
+#modal-box {
+    background: #1a252f;
+    border: 1px solid rgba(255,255,255,0.15);
+    border-radius: 20px;
+    padding: 26px 30px;
+    max-width: 480px; width: 90%;
+    text-align: center;
+}
+#modal-box h2 { color: #fbc531; margin-bottom: 6px; font-size: 1.35rem; }
+#modal-box p  { color: #bbb; font-size: 0.88rem; margin-bottom: 14px; }
+#hand-preview {
+    display: flex; justify-content: center; align-items: flex-end;
+    min-height: 118px; margin-bottom: 16px;
+}
+#trump-opts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }
+.suit-btn {
+    font-family: var(--font-ui);
+    font-size: 1.05rem; font-weight: 700;
+    padding: 11px 8px;
+    border-radius: 10px; border: 2px solid transparent;
+    background: #2c3e50; color: #fff;
+    cursor: pointer;
+    display: flex; align-items: center; justify-content: center; gap: 7px;
+    transition: all .2s;
+}
+.suit-btn:hover { background: #3d5166; border-color: #fbc531; transform: translateY(-2px); }
+.suit-btn.red-s .ss { color: #e84118; }
+.suit-btn.blk-s .ss { color: #ecf0f1; }
+
+/* ===== STATS MODAL ===== */
+#stats-modal {
+    position: fixed; inset: 0;
+    background: rgba(0,0,0,0.8);
+    backdrop-filter: blur(6px);
+    display: flex; align-items: center; justify-content: center;
+    z-index: 800;
+}
+#stats-modal.hidden { display: none; }
+#stats-box {
+    background: #1a252f;
+    border: 1px solid rgba(255,255,255,0.15);
+    border-radius: 20px;
+    padding: 26px 30px;
+    width: 500px; max-width: 95vw;
+}
+#stats-box h2 { color: #fbc531; margin-bottom: 16px; font-size: 1.25rem; text-align: center; }
+.stats-section { margin-bottom: 16px; }
+.stats-section h3 { font-size: 0.8rem; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; }
+.stats-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
+.stats-table td { padding: 5px 8px; }
+.stats-table td:first-child { color: #ccc; width: 80px; }
+.stats-table td:nth-child(2) { color: #fff; font-weight: 700; width: 36px; text-align: center; }
+.stat-bar-bg { background: rgba(255,255,255,0.08); border-radius: 4px; height: 8px; overflow: hidden; }
+.stat-bar { height: 8px; border-radius: 4px; transition: width 0.8s ease; }
+.team-stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+.team-stat-box {
+    background: rgba(255,255,255,0.06);
+    border-radius: 10px; padding: 10px 14px;
+    font-size: 0.8rem;
+}
+.team-stat-box .team-name { font-size: 0.72rem; color: #888; text-transform: uppercase; font-weight: 700; margin-bottom: 6px; }
+.team-stat-row { display: flex; justify-content: space-between; color: #ccc; padding: 2px 0; }
+.team-stat-row span { color: #fff; font-weight: 700; }
+.mvp-box {
+    background: rgba(251,197,49,0.1);
+    border: 1px solid rgba(251,197,49,0.3);
+    border-radius: 10px; padding: 8px 14px;
+    font-size: 0.85rem; text-align: center; color: #fbc531;
+}
+.stats-close-wrap { display: flex; justify-content: center; margin-top: 16px; }
+
+/* ===== ANIMATION UTILITIES ===== */
+.hidden { display: none !important; }
diff --git a/styles/menu.css b/styles/menu.css
new file mode 100644
index 0000000..cbb2dbf
--- /dev/null
+++ b/styles/menu.css
@@ -0,0 +1,419 @@
+html,
+body {
+    min-height: 100%;
+}
+
+body.menu-page {
+    min-height: 100svh;
+    overflow: hidden;
+    background:
+        radial-gradient(circle at 50% 32%, rgba(255, 255, 255, 0.045), transparent 20%),
+        radial-gradient(circle at 50% 64%, rgba(255, 255, 255, 0.018), transparent 34%),
+        var(--menu-bg);
+}
+
+.menu-shell {
+    position: relative;
+    min-height: 100svh;
+    display: grid;
+    grid-template-rows: auto 1fr auto;
+    isolation: isolate;
+    overflow: hidden;
+}
+
+.menu-shell::before {
+    content: "";
+    position: absolute;
+    inset: -12%;
+    z-index: -2;
+    pointer-events: none;
+    background: radial-gradient(ellipse at center, transparent 34%, rgba(0, 0, 0, 0.42) 70%, #000 100%);
+}
+
+.menu-shell::after {
+    content: "";
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    pointer-events: none;
+    opacity: 0.28;
+    background-image:
+        linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
+        linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
+    background-size: 56px 56px;
+    mask-image: radial-gradient(circle at center, #000 0%, transparent 68%);
+}
+
+.menu-topbar {
+    min-height: 78px;
+    padding: 18px clamp(20px, 4vw, 64px);
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 20px;
+}
+
+.menu-brand {
+    display: inline-flex;
+    align-items: baseline;
+    gap: 11px;
+    text-decoration: none;
+}
+
+.menu-brand .brand-wordmark {
+    font-size: 1.7rem;
+    line-height: 1;
+    letter-spacing: -0.025em;
+}
+
+.menu-brand .brand-suits {
+    font-family: var(--font-card);
+    font-size: .82rem;
+    letter-spacing: .12em;
+    color: var(--menu-text-muted);
+}
+
+.menu-top-actions {
+    display: flex;
+    align-items: center;
+    gap: 8px;
+}
+
+.round-icon-button {
+    width: 42px;
+    height: 42px;
+    display: grid;
+    place-items: center;
+    border: 1px solid transparent;
+    border-radius: 50%;
+    background: transparent;
+    color: var(--menu-text-muted);
+    cursor: pointer;
+    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease, background var(--duration-fast) ease;
+}
+
+.round-icon-button:hover {
+    color: var(--menu-text);
+    border-color: var(--menu-line);
+    background: rgba(255,255,255,.025);
+}
+
+.round-icon-button svg {
+    width: 19px;
+    height: 19px;
+    fill: none;
+    stroke: currentColor;
+    stroke-width: 1.5;
+}
+
+.menu-main {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) minmax(320px, 480px) minmax(0, 1fr);
+    align-items: center;
+    min-height: 0;
+    padding: 20px clamp(20px, 5vw, 80px) 30px;
+}
+
+.menu-rail {
+    height: min(64vh, 570px);
+    position: relative;
+}
+
+.menu-rail::after {
+    content: "";
+    position: absolute;
+    top: 8%;
+    bottom: 8%;
+    width: 1px;
+    background: linear-gradient(transparent, var(--menu-line), transparent);
+}
+
+.menu-rail:first-child::after {
+    right: 18%;
+}
+
+.menu-rail:last-child::after {
+    left: 18%;
+}
+
+.menu-content {
+    width: 100%;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    text-align: center;
+    animation: menu-enter 850ms var(--ease-cinematic) both;
+}
+
+.suit-crown {
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    gap: 13px;
+    min-height: 58px;
+    margin-bottom: 10px;
+    font-family: var(--font-card);
+    font-size: clamp(1.9rem, 3vw, 2.65rem);
+    color: rgba(245,242,234,.90);
+    letter-spacing: .04em;
+}
+
+.suit-crown span:nth-child(2),
+.suit-crown span:nth-child(3) {
+    transform: translateY(-7px);
+}
+
+.menu-title {
+    margin: 0;
+    font-size: clamp(4.6rem, 8vw, 7.1rem);
+    line-height: .78;
+    letter-spacing: -.045em;
+}
+
+.menu-subtitle {
+    margin: 30px 0 42px;
+    font-family: var(--font-menu);
+    font-size: clamp(1.1rem, 1.7vw, 1.38rem);
+    font-style: italic;
+    color: var(--menu-text-muted);
+}
+
+.menu-actions {
+    width: min(100%, 330px);
+    display: grid;
+    gap: 11px;
+}
+
+.menu-action {
+    position: relative;
+    min-height: 58px;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    justify-content: center;
+    gap: 3px;
+    padding: 10px 24px;
+    border: 1px solid var(--menu-line);
+    border-radius: var(--radius-sm);
+    background: rgba(255,255,255,.012);
+    color: var(--menu-text);
+    text-decoration: none;
+    cursor: pointer;
+    overflow: hidden;
+    isolation: isolate;
+    transition: transform var(--duration-normal) var(--ease-cinematic), border-color var(--duration-normal) ease, color var(--duration-normal) ease;
+}
+
+.menu-action::before {
+    content: "";
+    position: absolute;
+    inset: 0;
+    z-index: -1;
+    background: var(--menu-text);
+    transform: translateY(102%);
+    transition: transform 420ms var(--ease-cinematic);
+}
+
+.menu-action:hover,
+.menu-action:focus-visible {
+    transform: translateY(-2px);
+    border-color: var(--menu-text);
+    color: #060706;
+}
+
+.menu-action:hover::before,
+.menu-action:focus-visible::before {
+    transform: translateY(0);
+}
+
+.menu-action-primary {
+    min-height: 68px;
+    border-color: var(--menu-line-strong);
+    font-family: var(--font-menu);
+    font-size: 1.45rem;
+}
+
+.menu-action-secondary {
+    font-family: var(--font-menu);
+    font-size: 1.23rem;
+}
+
+.action-caption {
+    font-family: var(--font-ui);
+    font-size: .58rem;
+    line-height: 1.2;
+    letter-spacing: .16em;
+    text-transform: uppercase;
+    color: currentColor;
+    opacity: .58;
+}
+
+.tutorial-status {
+    display: inline-flex;
+    align-items: center;
+    gap: 6px;
+}
+
+.tutorial-status[data-complete="true"]::after {
+    content: "Completed";
+    padding: 2px 6px;
+    border: 1px solid currentColor;
+    border-radius: 99px;
+    font-family: var(--font-ui);
+    font-size: .48rem;
+    letter-spacing: .08em;
+    text-transform: uppercase;
+    opacity: .58;
+}
+
+.menu-footer {
+    min-height: 64px;
+    padding: 12px clamp(20px, 4vw, 64px) 20px;
+    display: flex;
+    align-items: flex-end;
+    justify-content: space-between;
+    gap: 18px;
+    color: rgba(245,242,234,.30);
+    font-size: .62rem;
+    letter-spacing: .12em;
+    text-transform: uppercase;
+}
+
+.menu-footer a {
+    text-decoration: none;
+    color: inherit;
+}
+
+.menu-footer a:hover {
+    color: var(--menu-text-muted);
+}
+
+.settings-backdrop[hidden] {
+    display: none;
+}
+
+.settings-backdrop {
+    position: fixed;
+    inset: 0;
+    z-index: 30;
+    display: grid;
+    place-items: center;
+    padding: 24px;
+    background: rgba(0,0,0,.82);
+    backdrop-filter: blur(12px);
+}
+
+.settings-panel {
+    width: min(100%, 440px);
+    padding: 30px;
+    border: 1px solid var(--menu-line);
+    border-radius: var(--radius-sm);
+    background: #050605;
+    box-shadow: 0 28px 100px rgba(0,0,0,.58);
+}
+
+.settings-header {
+    display: flex;
+    align-items: flex-start;
+    justify-content: space-between;
+    gap: 20px;
+    margin-bottom: 26px;
+}
+
+.settings-title {
+    margin: 0;
+    font-family: var(--font-menu);
+    font-size: 2.45rem;
+    font-weight: 400;
+    line-height: 1;
+}
+
+.settings-copy {
+    margin: 7px 0 0;
+    color: var(--menu-text-muted);
+    font-size: .75rem;
+    line-height: 1.6;
+}
+
+.settings-close {
+    width: 38px;
+    height: 38px;
+    border: 0;
+    background: transparent;
+    color: var(--menu-text-muted);
+    font-size: 1.7rem;
+    cursor: pointer;
+}
+
+.settings-grid {
+    display: grid;
+    gap: 18px;
+}
+
+.setting-field {
+    display: grid;
+    gap: 8px;
+}
+
+.setting-field label {
+    font-size: .68rem;
+    letter-spacing: .12em;
+    text-transform: uppercase;
+    color: var(--menu-text-muted);
+}
+
+.setting-field select {
+    width: 100%;
+    min-height: 46px;
+    padding: 0 12px;
+    border: 1px solid var(--menu-line);
+    border-radius: var(--radius-sm);
+    background: #080a09;
+    color: var(--menu-text);
+}
+
+.settings-note {
+    margin: 22px 0 0;
+    color: rgba(245,242,234,.42);
+    font-size: .67rem;
+    line-height: 1.65;
+}
+
+@keyframes menu-enter {
+    from { opacity: 0; transform: translateY(14px); filter: blur(7px); }
+    to { opacity: 1; transform: translateY(0); filter: blur(0); }
+}
+
+@media (max-width: 900px) {
+    .menu-main {
+        grid-template-columns: 1fr;
+    }
+
+    .menu-rail {
+        display: none;
+    }
+}
+
+@media (max-width: 560px) {
+    body.menu-page {
+        overflow: auto;
+    }
+
+    .menu-topbar {
+        min-height: 68px;
+        padding: 14px 18px;
+    }
+
+    .menu-main {
+        padding: 30px 20px;
+    }
+
+    .menu-subtitle {
+        margin-bottom: 34px;
+    }
+
+    .menu-footer {
+        min-height: 54px;
+        padding-inline: 18px;
+    }
+}
diff --git a/styles/tokens.css b/styles/tokens.css
new file mode 100644
index 0000000..5a86538
--- /dev/null
+++ b/styles/tokens.css
@@ -0,0 +1,47 @@
+:root {
+    /* Typography */
+    --font-menu: "Cormorant Garamond", Georgia, "Times New Roman", serif;
+    --font-ui: "Manrope", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+    --font-display: "Barlow Condensed", "Arial Narrow", sans-serif;
+    --font-card: Georgia, "Times New Roman", serif;
+
+    /* Welcome / menu palette */
+    --menu-bg: #030403;
+    --menu-surface: #080a09;
+    --menu-text: #f5f2ea;
+    --menu-text-muted: rgba(245, 242, 234, 0.68);
+    --menu-line: rgba(245, 242, 234, 0.20);
+    --menu-line-strong: rgba(245, 242, 234, 0.52);
+
+    /* Gameplay palette — introduced now, consumed progressively from Patch 9. */
+    --game-bg: #07120d;
+    --table-felt: #0b5b3a;
+    --accent-gold: #e8c46a;
+    --card-white: #f8f5ed;
+    --suit-red: #d94a4a;
+    --suit-black: #161918;
+
+    /* Shared spacing */
+    --space-1: 0.25rem;
+    --space-2: 0.5rem;
+    --space-3: 0.75rem;
+    --space-4: 1rem;
+    --space-5: 1.5rem;
+    --space-6: 2rem;
+    --space-7: 3rem;
+    --space-8: 4rem;
+
+    /* Shared radii / motion */
+    --radius-sm: 0.25rem;
+    --radius-md: 0.625rem;
+    --radius-lg: 1rem;
+    --ease-cinematic: cubic-bezier(0.19, 1, 0.22, 1);
+    --ease-standard: cubic-bezier(0.2, 0.8, 0.2, 1);
+    --duration-fast: 160ms;
+    --duration-normal: 300ms;
+    --duration-slow: 700ms;
+
+    /* Card sizing tokens for the current UI and Patch 10. */
+    --card-width: 72px;
+    --card-height: 108px;
+}
diff --git a/styles/tutorial.css b/styles/tutorial.css
new file mode 100644
index 0000000..b64a4ef
--- /dev/null
+++ b/styles/tutorial.css
@@ -0,0 +1,503 @@
+html,
+body {
+    min-height: 100%;
+}
+
+body.tutorial-page {
+    min-height: 100svh;
+    overflow: hidden;
+    background:
+        radial-gradient(circle at 72% 35%, rgba(255,255,255,.035), transparent 24%),
+        var(--menu-bg);
+}
+
+.tutorial-shell {
+    min-height: 100svh;
+    display: grid;
+    grid-template-rows: auto minmax(0, 1fr) auto;
+}
+
+.tutorial-header {
+    min-height: 78px;
+    padding: 15px clamp(18px, 4vw, 60px);
+    display: grid;
+    grid-template-columns: 1fr auto 1fr;
+    align-items: center;
+    gap: 20px;
+    border-bottom: 1px solid rgba(255,255,255,.08);
+}
+
+.tutorial-brand {
+    justify-self: start;
+    font-family: var(--font-menu);
+    font-size: 1.5rem;
+    text-decoration: none;
+}
+
+.tutorial-progress-text {
+    font-family: var(--font-menu);
+    font-size: 1.05rem;
+    color: var(--menu-text-muted);
+}
+
+.tutorial-exit {
+    justify-self: end;
+    min-width: 88px;
+    height: 40px;
+    border: 1px solid var(--menu-line);
+    border-radius: var(--radius-sm);
+    background: transparent;
+    color: var(--menu-text-muted);
+    text-decoration: none;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    font-size: .72rem;
+    letter-spacing: .08em;
+    text-transform: uppercase;
+    transition: color var(--duration-fast) ease, border-color var(--duration-fast) ease;
+}
+
+.tutorial-exit:hover {
+    color: var(--menu-text);
+    border-color: var(--menu-line-strong);
+}
+
+.tutorial-main {
+    min-height: 0;
+    overflow: auto;
+    display: grid;
+    place-items: center;
+    padding: clamp(26px, 5vh, 58px) clamp(18px, 4vw, 60px);
+}
+
+.tutorial-layout {
+    width: min(100%, 1040px);
+    display: grid;
+    grid-template-columns: minmax(280px, .9fr) minmax(360px, 1.1fr);
+    gap: clamp(40px, 7vw, 90px);
+    align-items: center;
+}
+
+.tutorial-copy {
+    max-width: 500px;
+    animation: tutorial-enter 430ms var(--ease-cinematic) both;
+}
+
+.tutorial-kicker {
+    margin-bottom: 11px;
+    font-size: .64rem;
+    letter-spacing: .18em;
+    text-transform: uppercase;
+    color: rgba(245,242,234,.42);
+}
+
+.tutorial-step-title {
+    margin: 0;
+    font-size: clamp(3.25rem, 5.8vw, 5.2rem);
+    line-height: .91;
+    letter-spacing: -.035em;
+}
+
+.tutorial-body-copy {
+    margin: 25px 0 0;
+    font-size: .9rem;
+    line-height: 1.85;
