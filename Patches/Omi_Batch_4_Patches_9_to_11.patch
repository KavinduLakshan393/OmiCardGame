@@ -0,0 +1,127 @@
+/* Batch 4 — presentation motion. No rules depend on these durations. */
+.deal-in {
+    animation: dealIn var(--motion-medium, 420ms) var(--ease-cine) both;
+    animation-delay: calc(var(--deal-index, 0) * 45ms);
+}
+@keyframes dealIn {
+    from { opacity: 0; transform: translate(var(--deal-x, 0), var(--deal-y, -90px)) rotate(var(--deal-rotate, -8deg)) scale(.72); }
+    to { opacity: 1; }
+}
+
+.play-flight {
+    position: fixed !important;
+    z-index: 1500 !important;
+    pointer-events: none !important;
+    margin: 0 !important;
+    transform-origin: center !important;
+    will-change: left, top, width, height, transform, opacity;
+}
+
+.collect-clone {
+    position: fixed !important;
+    z-index: 1450 !important;
+    pointer-events: none !important;
+    transition:
+        left 420ms var(--ease-cine),
+        top 420ms var(--ease-cine),
+        transform 420ms var(--ease-cine),
+        opacity 360ms ease;
+}
+
+.trick-winner-pulse { animation: winnerPulse 650ms var(--ease-cine); }
+@keyframes winnerPulse {
+    0% { filter: drop-shadow(0 0 0 rgba(232,196,106,0)); transform: scale(1); }
+    48% { filter: drop-shadow(0 0 18px rgba(232,196,106,.82)); transform: scale(1.055); }
+    100% { filter: drop-shadow(0 0 0 rgba(232,196,106,0)); transform: scale(1); }
+}
+
+#trick-win-overlay {
+    position: fixed;
+    left: 50%; top: 50%;
+    z-index: 1200;
+    transform: translate(-50%, -50%) translateY(14px) scale(.96);
+    opacity: 0;
+    pointer-events: none;
+    padding: .65rem 1rem;
+    border: 1px solid rgba(232,196,106,.42);
+    border-radius: 999px;
+    background: rgba(3,12,8,.9);
+    color: var(--accent-gold);
+    font: 700 .72rem/1 var(--font-ui);
+    box-shadow: 0 18px 45px rgba(0,0,0,.35);
+    transition: opacity .22s ease, transform .32s var(--ease-cine);
+}
+#trick-win-overlay.show { opacity: 1; transform: translate(-50%, -50%) translateY(0) scale(1); }
+
+#round-overlay,
+#match-win-overlay,
+#modal-overlay,
+#stats-modal {
+    position: fixed;
+    inset: 0;
+    z-index: 1100;
+    display: grid;
+    place-items: center;
+    padding: 20px;
+    background: rgba(0,0,0,.76);
+    backdrop-filter: blur(14px);
+}
+#round-overlay-box,
+#match-win-box,
+#modal-box,
+#stats-box {
+    width: min(92vw, 520px);
+    max-height: 88svh;
+    overflow: auto;
+    padding: clamp(22px, 4vw, 36px);
+    border: 1px solid rgba(248,245,237,.14);
+    border-radius: 22px;
+    background: linear-gradient(180deg, rgba(12,31,22,.98), rgba(4,14,9,.98));
+    box-shadow: 0 28px 80px rgba(0,0,0,.48);
+    text-align: center;
+    animation: modalIn .38s var(--ease-cine) both;
+}
+@keyframes modalIn { from { opacity: 0; transform: translateY(18px) scale(.985); } to { opacity: 1; transform: none; } }
+#round-overlay-msg { color: var(--accent-gold); font: 600 clamp(1.1rem, 3vw, 1.5rem)/1.35 var(--font-brand); }
+#match-winner-text { margin-top: .5rem; color: var(--accent-gold); font: 600 clamp(2rem, 5vw, 3rem)/1 var(--font-brand); }
+#match-stats-text { margin: 1rem 0 1.4rem; color: rgba(248,245,237,.62); font: 500 .82rem/1.5 var(--font-ui); }
+.match-win-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: .6rem; }
+
+#modal-box h2, #stats-box h2 { margin: .45rem 0 .5rem; font: 600 clamp(2rem, 4vw, 2.7rem)/1 var(--font-brand); }
+#modal-box p { margin: 0 auto 1rem; max-width: 38ch; color: rgba(248,245,237,.58); font: 500 .76rem/1.55 var(--font-ui); }
+#hand-preview { min-height: 150px; display: flex; align-items: flex-end; justify-content: center; margin: 1rem 0 1.35rem; }
+#trump-opts { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem; }
+.suit-btn {
+    min-height: 58px;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    gap: .55rem;
+    border: 1px solid rgba(248,245,237,.14);
+    border-radius: 14px;
+    background: rgba(248,245,237,.035);
+    color: var(--card-white);
+    cursor: pointer;
+    font: 600 .8rem/1 var(--font-ui);
+    transition: transform .2s var(--ease-cine), border-color .2s ease, background .2s ease;
+}
+.suit-btn .ss { font: 400 1.7rem/1 var(--font-card); }
+.suit-btn.red-s .ss { color: var(--suit-red); }
+.suit-btn:hover, .suit-btn:focus-visible { transform: translateY(-2px); border-color: rgba(232,196,106,.6); background: rgba(232,196,106,.07); outline: none; }
+
+.stats-section { margin-top: 1rem; text-align: left; }
+.stats-section h3 { margin: 0 0 .55rem; color: rgba(248,245,237,.45); font: 700 .58rem/1 var(--font-ui); letter-spacing: .15em; text-transform: uppercase; }
+.stats-table { width: 100%; border-collapse: collapse; font: 500 .74rem/1.4 var(--font-ui); }
+.stats-table td { padding: .4rem .3rem; }
+.stat-bar-bg { height: 6px; border-radius: 999px; overflow: hidden; background: rgba(248,245,237,.08); }
+.stat-bar { height: 100%; border-radius: inherit; }
+.team-stats-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .65rem; }
+.team-stat-box, .mvp-box { padding: .8rem; border: 1px solid rgba(248,245,237,.09); border-radius: 12px; background: rgba(248,245,237,.025); }
+.team-name { margin-bottom: .45rem; color: var(--accent-gold); font: 700 .65rem/1 var(--font-ui); text-transform: uppercase; letter-spacing: .08em; }
+.team-stat-row { display: flex; justify-content: space-between; padding: .18rem 0; color: rgba(248,245,237,.62); font: 500 .72rem/1.4 var(--font-ui); }
+.stats-close-wrap { margin-top: 1.2rem; display: flex; justify-content: center; }
+
+@media (prefers-reduced-motion: reduce) {
+    .deal-in, .trick-winner-pulse, #round-overlay-box, #match-win-box, #modal-box, #stats-box { animation: none !important; }
+    .play-flight, .collect-clone { transition-duration: 1ms !important; }
+}
diff --git a/styles/cards.css b/styles/cards.css
new file mode 100644
index 0000000..fab1bc8
--- /dev/null
+++ b/styles/cards.css
@@ -0,0 +1,187 @@
+/* Batch 4 — production card component. */
+:root {
+    --card-width-human: clamp(70px, 7vw, 92px);
+    --card-height-human: calc(var(--card-width-human) * 1.46);
+    --card-width-table: clamp(58px, 5.1vw, 72px);
+    --card-height-table: calc(var(--card-width-table) * 1.46);
+    --card-width-opponent: clamp(42px, 4vw, 58px);
+    --card-height-opponent: calc(var(--card-width-opponent) * 1.46);
+    --card-radius: 9px;
+}
+
+.card-wrapper {
+    position: relative;
+    flex: 0 0 auto;
+    transform-origin: 50% 100%;
+    transition: transform .22s var(--ease-cine), filter .18s ease;
+    will-change: transform;
+}
+.card {
+    position: relative;
+    width: var(--card-width-human);
+    height: var(--card-height-human);
+    overflow: hidden;
+    border-radius: var(--card-radius);
+    border: 1px solid rgba(23,20,12,.18);
+    background:
+        linear-gradient(145deg, rgba(255,255,255,.7), transparent 34%),
+        var(--card-white);
+    box-shadow: 0 10px 24px rgba(0,0,0,.28), 0 1px 0 rgba(255,255,255,.7) inset;
+    color: var(--suit-black);
+    font-family: var(--font-card);
+    user-select: none;
+    -webkit-user-select: none;
+}
+.card.red { color: var(--suit-red); }
+.card.black { color: var(--suit-black); }
+
+.card-corner {
+    position: absolute;
+    z-index: 4;
+    display: flex;
+    flex-direction: column;
+    align-items: center;
+    line-height: .88;
+    font-weight: 700;
+}
+.card-corner--tl { top: 6px; left: 6px; }
+.card-corner--br { right: 6px; bottom: 6px; transform: rotate(180deg); }
+.card-rank { font-size: clamp(.78rem, 1.15vw, 1rem); }
+.card-corner-suit { margin-top: 2px; font-size: clamp(.58rem, .9vw, .78rem); }
+
+.card-center-art {
+    position: absolute;
+    inset: 17% 18%;
+    display: grid;
+    place-items: center;
+}
+.card-ace-mark { font-size: clamp(2.1rem, 4.2vw, 3.8rem); line-height: 1; }
+
+.pip-grid {
+    width: 100%;
+    height: 100%;
+    display: grid;
+    grid-template-columns: repeat(3, 1fr);
+    grid-template-rows: repeat(5, 1fr);
+    align-items: center;
+    justify-items: center;
+}
+.pip {
+    font-size: clamp(.68rem, 1.25vw, 1.05rem);
+    line-height: 1;
+}
+.pip.upside { transform: rotate(180deg); }
+
+.court-art {
+    width: 100%;
+    height: 100%;
+    display: grid;
+    place-items: center;
+    border: 1px solid currentColor;
+    border-radius: 5px;
+    opacity: .92;
+    background:
+        linear-gradient(135deg, transparent 48%, currentColor 48% 50%, transparent 50%),
+        linear-gradient(45deg, transparent 48%, currentColor 48% 50%, transparent 50%);
+}
+.court-art::before,
+.court-art::after {
+    position: absolute;
+    width: 48%;
+    text-align: center;
+    font: 600 clamp(1.45rem, 2.6vw, 2.15rem)/1 var(--font-card);
+}
+.court-art::before { content: attr(data-rank); top: 27%; }
+.court-art::after { content: attr(data-rank); bottom: 27%; transform: rotate(180deg); }
+.court-suit {
+    position: absolute;
+    font-size: clamp(.78rem, 1.4vw, 1.12rem);
+    background: var(--card-white);
+    padding: .12rem .2rem;
+}
+
+.card.face-down {
+    width: var(--card-width-opponent);
+    height: var(--card-height-opponent);
+    border-color: rgba(232,196,106,.52);
+    background:
+        radial-gradient(circle at center, rgba(232,196,106,.10), transparent 36%),
+        repeating-linear-gradient(45deg, transparent 0 7px, rgba(232,196,106,.055) 7px 8px),
+        #081b14;
+    box-shadow: 0 8px 18px rgba(0,0,0,.26);
+}
+.card.face-down::before {
+    content: "♠ ♥\A ♦ ♣";
+    white-space: pre;
+    position: absolute;
+    inset: 5px;
+    display: grid;
+    place-items: center;
+    text-align: center;
+    border: 1px solid rgba(232,196,106,.28);
+    border-radius: 5px;
+    color: rgba(232,196,106,.68);
+    font: 600 clamp(.5rem, .8vw, .68rem)/1.5 var(--font-card);
+}
+.card.face-down::after {
+    content: "OMI";
+    position: absolute;
+    left: 50%; top: 50%;
+    transform: translate(-50%, -50%) rotate(-25deg);
+    color: rgba(232,196,106,.18);
+    font: 700 clamp(.46rem, .7vw, .6rem)/1 var(--font-display);
+    letter-spacing: .12em;
+}
+
+.trick-slot .card {
+    width: var(--card-width-table);
+    height: var(--card-height-table);
+    cursor: default;
+    box-shadow: 0 10px 26px rgba(0,0,0,.30);
+}
+.trick-slot .card-rank { font-size: clamp(.7rem, .95vw, .88rem); }
+.trick-slot .pip { font-size: clamp(.55rem, .9vw, .82rem); }
+
+.card.card-valid {
+    cursor: pointer;
+    border-color: rgba(232,196,106,.82);
+    box-shadow: 0 12px 28px rgba(0,0,0,.3), 0 0 0 2px rgba(232,196,106,.16);
+}
+.card.card-invalid {
+    opacity: .42;
+    filter: saturate(.55) brightness(.72);
+    cursor: not-allowed;
+}
+.card.card-selected {
+    box-shadow: 0 16px 36px rgba(0,0,0,.36), 0 0 0 3px rgba(232,196,106,.24);
+}
+.card.shake { animation: shakeCard .34s ease; }
+@keyframes shakeCard {
+    0%,100% { transform: translateX(0); }
+    30% { transform: translateX(-6px); }
+    65% { transform: translateX(6px); }
+}
+
+.mini-card {
+    width: 54px;
+    aspect-ratio: .685;
+    display: grid;
+    place-items: center;
+    border-radius: 6px;
+    border: 1px solid rgba(0,0,0,.18);
+    background: var(--card-white);
+    color: var(--suit-black);
+    font: 700 .82rem/1 var(--font-card);
+    box-shadow: 0 6px 14px rgba(0,0,0,.18);
+}
+.mini-card.red { color: var(--suit-red); }
+
+@media (max-width: 620px) {
+    :root {
+        --card-width-human: clamp(54px, 16vw, 72px);
+        --card-width-table: clamp(48px, 13vw, 60px);
+        --card-width-opponent: 40px;
+    }
+    .card-corner--tl { top: 4px; left: 4px; }
+    .card-corner--br { right: 4px; bottom: 4px; }
+}
diff --git a/styles/table.css b/styles/table.css
new file mode 100644
index 0000000..aca13a8
--- /dev/null
+++ b/styles/table.css
@@ -0,0 +1,459 @@
+/* Batch 4 — responsive gameplay table. Presentation only; rules stay in src/engine. */
+.game-page {
+    min-height: 100svh;
+    overflow-x: hidden;
+    background:
+        radial-gradient(circle at 50% 18%, rgba(232, 196, 106, .08), transparent 26%),
+        linear-gradient(180deg, #08150f 0%, var(--game-bg) 56%, #030806 100%);
+    color: var(--color-text-primary);
+}
+
+.skip-link {
+    position: fixed;
+    left: 1rem;
+    top: -5rem;
+    z-index: 2000;
+    padding: .75rem 1rem;
+    background: var(--card-white);
+    color: #111;
+    border-radius: .5rem;
+}
+.skip-link:focus { top: 1rem; }
+
+#game-board {
+    min-height: 100svh;
+    display: grid;
+    grid-template-rows: auto minmax(0, 1fr) auto;
+    width: min(100%, 1600px);
+    margin: 0 auto;
+}
+
+.game-hud {
+    min-height: 78px;
+    display: grid;
+    grid-template-columns: 1fr auto 1fr;
+    align-items: center;
+    gap: clamp(1rem, 3vw, 3rem);
+    padding: 14px clamp(16px, 3vw, 42px);
+    border-bottom: 1px solid rgba(248, 245, 237, .09);
+    background: rgba(3, 9, 6, .68);
+    backdrop-filter: blur(18px);
+    z-index: 20;
+}
+
+.hud-brand {
+    justify-self: start;
+    display: inline-flex;
+    align-items: center;
+    gap: .7rem;
+    color: inherit;
+    text-decoration: none;
+}
+.hud-brand-mark {
+    font-family: var(--font-card);
+    font-size: .78rem;
+    letter-spacing: -.08em;
+    color: var(--accent-gold);
+}
+.hud-brand-name {
+    font-family: var(--font-brand);
+    font-size: clamp(1.5rem, 2.2vw, 2rem);
+    line-height: 1;
+}
+
+.score-hud {
+    display: grid;
+    grid-template-columns: minmax(92px, 1fr) auto minmax(92px, 1fr);
+    align-items: center;
+    gap: clamp(.75rem, 2vw, 1.8rem);
+    min-width: min(440px, 46vw);
+}
+.team-score {
+    display: grid;
+    grid-template-columns: auto auto;
+    grid-template-areas: "label token" "trick token";
+    column-gap: .8rem;
+    align-items: center;
+}
+.team-score--ew { text-align: right; }
+.team-score .score-label {
+    grid-area: label;
+    font: 700 .68rem/1 var(--font-ui);
+    letter-spacing: .14em;
+    text-transform: uppercase;
+    color: rgba(248,245,237,.64);
+}
+.token-score {
+    grid-area: token;
+    font: 700 clamp(2rem, 3.4vw, 3rem)/.9 var(--font-display);
+    color: var(--accent-gold);
+}
+.trick-score {
+    grid-area: trick;
+    margin-top: .3rem;
+    font: 600 .8rem/1 var(--font-ui);
+    color: rgba(248,245,237,.8);
+}
+.score-divider {
+    display: grid;
+    place-items: center;
+    color: rgba(248,245,237,.36);
+    font: 700 .5rem/1 var(--font-ui);
+    letter-spacing: .16em;
+}
+.score-divider strong {
+    margin-top: .15rem;
+    color: rgba(248,245,237,.78);
+    font: 700 1.15rem/1 var(--font-display);
+}
+
+.header-controls {
+    justify-self: end;
+    display: flex;
+    gap: .45rem;
+}
+.icon-btn {
+    width: 42px;
+    height: 42px;
+    display: grid;
+    place-items: center;
+    border-radius: 999px;
+    border: 1px solid rgba(248,245,237,.14);
+    background: rgba(248,245,237,.035);
+    color: var(--card-white);
+    cursor: pointer;
+    text-decoration: none;
+    transition: transform .22s var(--ease-cine), border-color .22s ease, background .22s ease;
+}
+.icon-btn:hover:not(:disabled), .icon-btn:focus-visible {
+    transform: translateY(-2px);
+    border-color: rgba(232,196,106,.72);
+    background: rgba(232,196,106,.08);
+    outline: none;
+}
+.icon-btn:disabled { opacity: .28; cursor: default; }
+
+.table-shell {
+    min-height: 0;
+    display: grid;
+    place-items: center;
+    padding: clamp(12px, 2vw, 28px);
+}
+.felt-table {
+    position: relative;
+    width: min(1180px, 96vw);
+    height: min(720px, calc(100svh - 188px));
+    min-height: 520px;
+    border-radius: clamp(36px, 6vw, 86px);
+    overflow: hidden;
+    isolation: isolate;
+    background:
+        radial-gradient(ellipse at 50% 42%, rgba(255,255,255,.045), transparent 42%),
+        radial-gradient(ellipse at center, #0f6a47 0%, var(--table-felt) 48%, #073c29 100%);
+    border: 1px solid rgba(232,196,106,.28);
+    box-shadow:
+        0 34px 80px rgba(0,0,0,.44),
+        inset 0 0 0 8px rgba(0,0,0,.11),
+        inset 0 0 90px rgba(0,0,0,.28);
+}
+.felt-grain {
+    position: absolute;
+    inset: 0;
+    opacity: .09;
+    pointer-events: none;
+    z-index: -1;
+    background-image:
+        repeating-linear-gradient(18deg, rgba(255,255,255,.06) 0 1px, transparent 1px 4px),
+        repeating-linear-gradient(102deg, rgba(0,0,0,.08) 0 1px, transparent 1px 5px);
+    mix-blend-mode: overlay;
+}
+.table-ring {
+    position: absolute;
+    inset: clamp(22px, 3vw, 42px);
+    border: 1px solid rgba(248,245,237,.09);
+    border-radius: inherit;
+    pointer-events: none;
+}
+
+.player-seat {
+    position: absolute;
+    z-index: 8;
+    display: flex;
+    align-items: center;
+    gap: .7rem;
+}
+.seat-north { top: 18px; left: 50%; transform: translateX(-50%); flex-direction: column; }
+.seat-south { bottom: 10px; left: 50%; transform: translateX(-50%); flex-direction: column; }
+.seat-west { left: 20px; top: 50%; transform: translateY(-50%); flex-direction: row; }
+.seat-east { right: 20px; top: 50%; transform: translateY(-50%); flex-direction: row-reverse; }
+
+.player-identity {
+    display: flex;
+    align-items: center;
+    gap: .65rem;
+    min-width: 172px;
+    padding: .5rem .65rem;
+    border: 1px solid rgba(248,245,237,.10);
+    border-radius: 999px;
+    background: rgba(2, 12, 8, .72);
+    backdrop-filter: blur(10px);
+    transition: border-color .25s ease, box-shadow .25s ease, transform .25s var(--ease-cine);
+}
+.player-avatar {
+    width: 34px;
+    height: 34px;
+    flex: 0 0 auto;
+    display: grid;
+    place-items: center;
+    border-radius: 50%;
+    border: 1px solid rgba(232,196,106,.42);
+    color: var(--accent-gold);
+    background: rgba(232,196,106,.06);
+    font: 700 .8rem/1 var(--font-display);
+}
+.player-avatar--human { background: rgba(232,196,106,.14); }
+.player-copy { min-width: 0; display: flex; flex-direction: column; }
+.player-name { font: 700 .82rem/1.2 var(--font-ui); color: var(--card-white); }
+.player-role { margin-top: .16rem; font: 500 .6rem/1.2 var(--font-ui); color: rgba(248,245,237,.48); }
+.card-count {
+    margin-left: auto;
+    min-width: 25px;
+    height: 25px;
+    display: grid;
+    place-items: center;
+    border-radius: 50%;
+    background: rgba(248,245,237,.08);
+    color: rgba(248,245,237,.78);
+    font: 700 .68rem/1 var(--font-display);
+}
+.player-seat.active-turn .player-identity {
+    border-color: rgba(232,196,106,.78);
+    box-shadow: 0 0 0 3px rgba(232,196,106,.08), 0 0 26px rgba(232,196,106,.12);
+    transform: translateY(-2px);
+}
+.turn-badge {
+    position: absolute;
+    padding: .3rem .55rem;
+    border-radius: 999px;
+    background: var(--accent-gold);
+    color: #15130c;
+    font: 700 .58rem/1 var(--font-ui);
+    letter-spacing: .04em;
+    white-space: nowrap;
+    box-shadow: 0 8px 20px rgba(0,0,0,.24);
+}
+.seat-north .turn-badge { top: 54px; right: -12px; }
+.seat-south .turn-badge { bottom: 52px; right: -14px; }
+.seat-west .turn-badge { top: -10px; left: 20px; }
+.seat-east .turn-badge { top: -10px; right: 20px; }
+
+.opponent-hand { position: relative; display: flex; pointer-events: none; }
+.hand-north { justify-content: center; height: 66px; }
+.hand-west, .hand-east { flex-direction: column; width: 58px; justify-content: center; }
+.human-hand {
+    min-height: 154px;
+    display: flex;
+    align-items: flex-end;
+    justify-content: center;
+    padding: 0 1rem;
+    perspective: 1000px;
+}
+
+.trick-zone {
+    position: absolute;
+    left: 50%;
+    top: 48%;
+    transform: translate(-50%, -50%);
+    z-index: 6;
+    display: grid;
+    justify-items: center;
+    gap: .55rem;
+}
+.trick-zone-heading {
+    font: 700 .58rem/1 var(--font-ui);
+    text-transform: uppercase;
+    letter-spacing: .18em;
+    color: rgba(248,245,237,.36);
+}
+#trick-table {
+    position: relative;
+    width: clamp(280px, 34vw, 390px);
+    aspect-ratio: 1.35 / 1;
+    border-radius: 48%;
+    background: rgba(0,0,0,.10);
+    border: 1px solid rgba(248,245,237,.075);
+    box-shadow: inset 0 0 48px rgba(0,0,0,.12);
+}
+.trick-slot {
+    position: absolute;
+    width: var(--card-width-table);
+    height: var(--card-height-table);
+    display: grid;
+    place-items: center;
+}
+#trick-north { top: 6px; left: 50%; transform: translateX(-50%) rotate(2deg); }
+#trick-south { bottom: 6px; left: 50%; transform: translateX(-50%) rotate(-1deg); }
+#trick-west { left: 18px; top: 50%; transform: translateY(-50%) rotate(-4deg); }
+#trick-east { right: 18px; top: 50%; transform: translateY(-50%) rotate(4deg); }
+
+#trump-badge {
+    position: absolute;
+    left: 50%; top: 50%;
+    transform: translate(-50%, -50%);
+    min-width: 88px;
+    display: grid;
+    place-items: center;
+    gap: .08rem;
+    padding: .65rem .75rem;
+    border-radius: 16px;
+    border: 1px solid rgba(232,196,106,.22);
+    background: rgba(3, 17, 11, .78);
+    box-shadow: 0 12px 24px rgba(0,0,0,.18);
+    backdrop-filter: blur(12px);
+}
+.t-label { font: 700 .5rem/1 var(--font-ui); text-transform: uppercase; letter-spacing: .16em; color: rgba(232,196,106,.7); }
+.t-suit { font: 400 1.9rem/1 var(--font-card); }
+.t-caller { max-width: 76px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 500 .52rem/1.2 var(--font-ui); color: rgba(248,245,237,.44); }
+
+#deck-pile {
+    position: absolute;
+    left: 50%; top: 50%;
+    transform: translate(-50%, -50%);
+    width: var(--card-width-table);
+    height: var(--card-height-table);
+    z-index: 15;
+    display: none;
+}
+.deck-card {
+    position: absolute;
+    inset: 0;
+    border-radius: var(--card-radius);
+    border: 1px solid rgba(232,196,106,.52);
+    background:
+        linear-gradient(135deg, transparent 20%, rgba(232,196,106,.10) 20% 21%, transparent 21% 49%, rgba(232,196,106,.10) 49% 50%, transparent 50%),
+        #081a13;
+    box-shadow: 0 8px 20px rgba(0,0,0,.28);
+}
+.deck-card:nth-child(1) { transform: translate(-5px, 3px) rotate(-4deg); }
+.deck-card:nth-child(2) { transform: translate(3px, 2px) rotate(2deg); }
+.deck-card:nth-child(3)::after {
+    content: "OMI";
+    position: absolute;
+    inset: 8px;
+    display: grid;
+    place-items: center;
+    border: 1px solid rgba(232,196,106,.32);
+    border-radius: calc(var(--card-radius) - 3px);
+    color: rgba(232,196,106,.68);
+    font: 700 .7rem/1 var(--font-display);
+    letter-spacing: .16em;
+}
+
+#status-area {
+    min-height: 76px;
+    display: grid;
+    grid-template-columns: 1fr auto 1fr;
+    align-items: center;
+    padding: 10px clamp(16px, 3vw, 42px) max(10px, env(safe-area-inset-bottom));
+    border-top: 1px solid rgba(248,245,237,.08);
+    background: rgba(3, 9, 6, .78);
+    backdrop-filter: blur(16px);
+}
+#status-banner {
+    grid-column: 2;
+    text-align: center;
+    color: rgba(248,245,237,.86);
+    font: 600 .86rem/1.3 var(--font-ui);
+}
+.game-actions { grid-column: 3; justify-self: end; display: flex; gap: .55rem; }
+.btn {
+    min-height: 42px;
+    padding: 0 1rem;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    border-radius: 999px;
+    border: 1px solid rgba(248,245,237,.15);
+    font: 700 .72rem/1 var(--font-ui);
+    text-decoration: none;
+    cursor: pointer;
+    transition: transform .2s var(--ease-cine), background .2s ease, border-color .2s ease;
+}
+.btn:hover:not(:disabled), .btn:focus-visible { transform: translateY(-2px); outline: none; }
+.btn-primary { background: var(--accent-gold); color: #17140c; border-color: var(--accent-gold); }
+.btn-secondary { background: rgba(248,245,237,.035); color: var(--card-white); }
+.btn-secondary:hover { border-color: rgba(232,196,106,.5); background: rgba(232,196,106,.06); }
+.btn[hidden] { display: none !important; }
+
+.previous-trick-popover {
+    position: fixed;
+    top: 82px;
+    right: clamp(16px, 3vw, 42px);
+    z-index: 90;
+    width: min(360px, calc(100vw - 32px));
+    padding: 1rem;
+    border: 1px solid rgba(248,245,237,.13);
+    border-radius: 18px;
+    background: rgba(4, 13, 9, .94);
+    box-shadow: 0 22px 55px rgba(0,0,0,.4);
+    backdrop-filter: blur(18px);
+}
+.previous-trick-head { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
+.previous-trick-head strong { display: block; margin-top: .25rem; font: 600 1rem/1.2 var(--font-ui); }
+.eyebrow { font: 700 .56rem/1 var(--font-ui); letter-spacing: .16em; text-transform: uppercase; color: rgba(232,196,106,.7); }
+.popover-close { width: 32px; height: 32px; border: 0; background: transparent; color: #fff; font-size: 1.4rem; cursor: pointer; }
+.previous-trick-cards { margin-top: 1rem; display: flex; gap: .5rem; justify-content: center; }
+.history-empty { color: rgba(248,245,237,.4); font: 500 .75rem/1.3 var(--font-ui); }
+
+@media (max-width: 900px) {
+    .game-hud { grid-template-columns: auto 1fr auto; gap: .65rem; }
+    .hud-brand-name { display: none; }
+    .score-hud { min-width: 0; width: 100%; }
+    .felt-table { height: min(700px, calc(100svh - 174px)); min-height: 480px; border-radius: 36px; }
+    .player-identity { min-width: 0; padding: .42rem; }
+    .player-copy { display: none; }
+    .card-count { margin-left: 0; }
+    .seat-west { left: 10px; }
+    .seat-east { right: 10px; }
+    #status-area { grid-template-columns: 1fr; gap: .5rem; }
+    #status-banner, .game-actions { grid-column: 1; justify-self: center; }
+}
+
+@media (max-width: 620px) {
+    .game-hud { min-height: 68px; padding: 8px 10px; }
+    .score-hud { gap: .45rem; }
+    .team-score { column-gap: .35rem; }
+    .team-score .score-label { font-size: .52rem; letter-spacing: .08em; }
+    .token-score { font-size: 1.8rem; }
+    .trick-score { font-size: .65rem; }
+    .icon-btn { width: 36px; height: 36px; }
+    .header-controls .icon-link { display: none; }
+    .table-shell { padding: 8px; }
+    .felt-table { width: 100%; min-height: 500px; height: calc(100svh - 160px); border-radius: 28px; }
+    .table-ring { inset: 12px; }
+    .seat-north { top: 8px; }
+    .seat-south { bottom: 4px; width: 100%; }
+    .seat-west { left: 4px; }
+    .seat-east { right: 4px; }
+    .player-avatar { width: 30px; height: 30px; }
+    .player-identity { gap: .25rem; }
+    .card-count { min-width: 22px; height: 22px; font-size: .58rem; }
+    .human-hand { width: 100%; min-height: 132px; padding: 0 .25rem; }
+    .trick-zone { top: 45%; }
+    #trick-table { width: min(270px, 74vw); }
+    #trick-west { left: 4px; }
+    #trick-east { right: 4px; }
+    #status-area { min-height: 84px; padding: 8px 10px max(8px, env(safe-area-inset-bottom)); }
+    #status-banner { font-size: .74rem; }
+    .btn { min-height: 38px; padding-inline: .8rem; font-size: .65rem; }
+}
+
+@media (max-height: 620px) and (orientation: landscape) {
+    .game-hud { min-height: 58px; padding-block: 6px; }
+    .table-shell { padding-block: 6px; }
+    .felt-table { height: calc(100svh - 128px); min-height: 390px; }
+    #status-area { min-height: 58px; }
+    .human-hand { min-height: 108px; }
+    .seat-north { top: 5px; }
+    .seat-south { bottom: 0; }
+}
